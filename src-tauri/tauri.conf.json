{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tachyon Studio",
  "version": "2.5.0",
  "identifier": "com.tachyon.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tachyon Studio",
        "width": 1600,
        "height": 1000,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#090C0E",
        "decorations": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://tile.openstreetmap.org https://*.cartocdn.com blob: data:; media-src 'self' asset: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://tile.openstreetmap.org https://*.cartocdn.com asset:; font-src 'self' data:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$TEMP/tachyon*/**",
          "$TEMP/tachyon*",
          "$VIDEO/**",
          "$DOWNLOAD/**",
          "$DESKTOP/**",
          "$DOCUMENT/**",
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Tachyon Studio",
    "shortDescription": "Tachyon Studio Desktop - Telemetría y Vídeo en Streaming",
    "longDescription": "Aplicación de escritorio para análisis, sincronización y renderizado de telemetría automovilística con vídeo en streaming de memoria acotada.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
